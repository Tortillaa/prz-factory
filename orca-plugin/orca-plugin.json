{
  "manifestVersion": 2,
  "id": "prz-factory-board",
  "name": "prz-factory board",
  "version": "0.1.0",
  "description": "The prz-factory kanban board of each repo open in Orca, live in the sidebar.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "board",
        "title": "Factory board",
        "icon": "layers",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    }
  ]
}
